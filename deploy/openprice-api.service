# Replacement for /etc/systemd/system/openprice-api.service (NOT installed automatically; see deploy/README.md, step 5).
# Same unit as the live one, with 3 uvicorn worker processes. Each worker holds its own DuckDB instance, response
# cache and Parquet manifest poll (~350 MB each). Measured on this host (2026-09-25, uncached requests):
#   point requests, 8 concurrent clients: 56 -> 64 req/s (DuckDB already uses several cores per request);
#   12 range requests, 6 at a time:       7.6 s -> 4.4 s (bulk ranges are mostly Python, one core per process).
# The bind stays 0.0.0.0:8000: the gateway (gateway.deepmining.ch) reaches the API directly on that address.
[Unit]
Description=OpenPrice API
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/OpenPrice-API/openprice-api
ExecStart=/home/debian/OpenPrice-API/openprice-api/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 3
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openprice-api

[Install]
WantedBy=multi-user.target
